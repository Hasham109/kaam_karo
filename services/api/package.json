{
  "name": "@kaamkaro/api",
  "version": "0.0.0",
  "private": true,
  "description": "Kaam Karo backend: NestJS modular monolith (D-001, INFRA-001). Shell + health created by A01 in T2.1.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:comments": "node prisma/tools/db-schema.ts comments",
    "test:db": "prisma generate && vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@kaamkaro/platform": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@sentry/nestjs": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@kaamkaro/contracts": "workspace:*",
    "@nestjs/testing": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "ajv": "catalog:",
    "eslint": "catalog:",
    "prisma": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
