// ============================================================================
// Module M17 config — Configurable rules store. Owner: A03 (catalog-config).
// ARCH §4 M17, §5.3 (ConfigRule), §19; BP §42, §64; CFG-RULE-001…012.
// Tables: config_rule; config_key_policy (owner-maintained policy per key, SEC-REVIEW-T2.6 #2,
// created by A01 in T2.2 review fixes; rows generated from A03's registry). Values are seeded by T2.6 (decided values cite their D-number;
// undecided values are null + TODO(OWNER)). This migration seeds nothing.
// ============================================================================

/// Scope a config value applies to (ARCH §5.3 "scope = global/city/category/service"; BP §42, §64).
enum ConfigScope {
  GLOBAL
  CITY
  CATEGORY
  SERVICE

  @@map("config_scope")
}

/// APPEND-ONLY versioned configurable rule value: a change is a new row, never an edit, and effective_from is never back-dated (CHECK) (ARCH §5.3; BP §26, §42, §64; CFG-RULE-001…012). Two-person approval columns wait for OQ-076 and can be added as nullable columns.
model ConfigRule {
  /// Primary key, UUID (technical field, ARCH §5; BP §25).
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Rule key, e.g. commission.rate (ARCH §5.3 "key", §19; BP §42).
  key             String
  /// Scope kind (ARCH §5.3 "scope"; BP §64).
  scope           ConfigScope
  /// ID of the city/category/service the value applies to; null for GLOBAL; refs catalog by ID (ARCH §5.3; BP §64; CFG-RULE-001).
  scopeRefId      String?     @map("scope_ref_id") @db.Uuid
  /// The value as JSON; null = not decided by the owner yet, TODO(OWNER), and the safe behaviour applies (ARCH §5.3 "value"; BP §42; CFG-RULE-001…012).
  value           Json?
  /// When the value takes effect, without a deploy (ARCH §5.3 "effective_from"; BP §42).
  effectiveFrom   DateTime    @map("effective_from") @db.Timestamptz(3)
  /// Staff user who changed it; the change is also audited (ARCH §5.3 "changed_by"; BP §26; SEC-BASE-010).
  changedByUserId String?     @map("changed_by_user_id") @db.Uuid
  /// Row creation time (technical field, ARCH §5; BP §25).
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([key, scope, effectiveFrom], where: raw("scope_ref_id IS NULL"), map: "config_rule_global_key")
  @@unique([key, scope, scopeRefId, effectiveFrom], where: raw("scope_ref_id IS NOT NULL"), map: "config_rule_scoped_key")
  @@map("config_rule")
}

/// Owner-maintained policy for every config key: kind, allowed scopes, decided/read-only, two-person and fail-closed flags. A BEFORE INSERT trigger on config_rule enforces it, so the API login cannot write an unknown key, a wrong scope or type, a decided key or a null security limit (BP §26, §29, §42; CFG-RULE-003; SEC-BASE-010). The API login may only read it; rows are generated from the config registry by the seed, run as the table owner.
model ConfigKeyPolicy {
  /// Rule key, same as config_rule.key (BP §42; CFG-RULE-001).
  key           String        @id
  /// Value kind from the config registry, e.g. ratio, positive_integer, limit_object (BP §42; CFG-RULE-003).
  kind          String
  /// Scopes allowed for this key (BP §64; CFG-RULE-001).
  allowedScopes ConfigScope[] @map("allowed_scopes")
  /// Upper bound for integer kinds (unit ceiling); null = none (BP §42; SEC-AUTH-004).
  maxValue      Decimal?      @map("max_value") @db.Decimal(20, 6)
  /// Field → upper bound for limit_object kinds; every field is a positive integer (BP §29, §30; SEC-BASE-006).
  limitFields   Json?         @map("limit_fields")
  /// Owner-decided value: the API login may not write new versions (BP §42; CFG-RULE-003).
  readOnly      Boolean       @default(false) @map("read_only")
  /// Change needs two-person approval, which the API login cannot record yet (BP §29; SEC-BASE-010).
  twoPerson     Boolean       @default(false) @map("two_person")
  /// Security limit: the API login may never store null (BP §27, §29; SEC-AUTH-004).
  failClosed    Boolean       @default(false) @map("fail_closed")
  /// When the policy row was last generated (technical field, ARCH §5; BP §25).
  updatedAt     DateTime      @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("config_key_policy")
}
