# Kaam Karo — example environment (T2.1; SEC-BASE-008, SEC-BASE-011; BP §29, §34)
# FAKE VALUES ONLY. Copy to `.env` for local development. `.env` is git-ignored.
# Staging and production values come from the secret manager of the hosting
# platform (hosting vendor not chosen yet, BP §33) — never from a committed file.
# Values containing "fake" or "change-me" are refused when APP_ENV is staging or production.

# --- Environment selector (SEC-BASE-011) -----------------------------------
# One of: development | test | staging | production
APP_ENV=development

# --- API (services/api) ----------------------------------------------------
PORT=3000
# PostgreSQL + PostGIS (D-001). Two different roles (T2.3; BP §26, §29; SEC-REVIEW-T2.3 #1):
# - DATABASE_URL: the API's login. Member of kaamkaro_app, NOT the table owner, not superuser.
#   The API refuses to start when this login is a superuser, has BYPASSRLS or owns the tables.
# - MIGRATION_DATABASE_URL: the table owner, used only by `prisma migrate` / db tests. Never given to the API.
DATABASE_URL=postgresql://kaamkaro_api:fake-app-password-change-me@localhost:5432/kaamkaro_dev?schema=public
MIGRATION_DATABASE_URL=postgresql://kaamkaro:fake-dev-password-change-me@localhost:5432/kaamkaro_dev?schema=public
# Staging/production (SEC-REVIEW-T2.2 #7): DATABASE_URL and MIGRATION_DATABASE_URL must set
# sslmode=require|verify-ca|verify-full, and REDIS_URL must be rediss:// with a password.
# Redis (D-001): BullMQ queues for the outbox worker (T2.2). Queue state only; business data stays in PostgreSQL (REL-013)
REDIS_URL=redis://:fake-redis-password-change-me@localhost:6379
# Health probe timeout in milliseconds (technical setting, REL-011)
HEALTH_PROBE_TIMEOUT_MS=2000

# --- Platform technical settings (T2.2; NOT business values; defaults shown) ---
# Log level: debug | info | warn | error. Logs are JSON lines with personal data redacted.
LOG_LEVEL=info
# Config reader cache in ms (CFG-RULE-001: a config change is seen within this time; 0 = no cache)
CONFIG_CACHE_TTL_MS=30000
# Idempotency (REL-008): how long a result is replayed, and when an unfinished key counts as crashed
IDEMPOTENCY_KEY_TTL_HOURS=24
# Lease of a running idempotent request (heartbeat); must be >= HTTP_REQUEST_TIMEOUT_MS
IDEMPOTENCY_IN_FLIGHT_TIMEOUT_MS=60000
# Largest stored idempotent response in bytes; larger ones are not replayed (REPLAY_UNAVAILABLE)
IDEMPOTENCY_MAX_RESPONSE_BYTES=16384
# Server handler deadline in ms (Node server.requestTimeout); minimum 1000
HTTP_REQUEST_TIMEOUT_MS=30000
# Retention in days of PUBLISHED outbox rows / of dead letters (FAILED rows, failed + dead-letter
# jobs). Empty = keep everything: TODO(OWNER) OQ-080 (BP §26 retention not decided).
OUTBOX_RETENTION_DAYS=
DEAD_LETTER_RETENTION_DAYS=
# Outbox relay + queue consumers (REL-007, REL-009): polling, batch, attempts before dead-letter, backoff
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_MAX_MS=300000

# --- Monitoring (INFRA-005, D-001 Sentry) -----------------------------------
# Empty = Sentry disabled (no-op) — allowed only in development/test; staging and production
# refuse to boot without it (INFRA-005). Each environment uses its own DSN.
SENTRY_DSN=
# 0..1 share of requests traced. 0 = errors only.
SENTRY_TRACES_SAMPLE_RATE=0

# --- Local infrastructure (infra/docker-compose.yml, development only) ------
POSTGRES_USER=kaamkaro
POSTGRES_PASSWORD=fake-dev-password-change-me
POSTGRES_DB=kaamkaro_dev
POSTGRES_PORT=5432
# API login created on first start by infra/db/init/10-bootstrap.sh (must match DATABASE_URL above)
APP_DB_USER=kaamkaro_api
APP_DB_PASSWORD=fake-app-password-change-me
REDIS_PASSWORD=fake-redis-password-change-me
REDIS_PORT=6379

# --- Admin portal (apps/admin) ----------------------------------------------
# NEXT_PUBLIC_* values are shipped to the browser: never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# --- Mobile apps (apps/customer, apps/partner) ------------------------------
# EXPO_PUBLIC_* values are bundled into the app binary: never put a secret here (BP §29).
# 10.0.2.2 = host machine from the Android emulator. Release builds must use https (SEC-BASE-001).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
